# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
APP_NAME=GatherEase
APP_VERSION=0.1.0
DEBUG=true

# ── Database (PostgreSQL via AWS RDS) ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/gatherease
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── AWS Cognito ─────────────────────────────────────────────────────────────
COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=                       # leave blank if client has no secret

# ── AWS General ─────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=                           # local dev only; use IAM role in prod
AWS_SECRET_ACCESS_KEY=                       # local dev only; use IAM role in prod

# ── S3 ──────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=gatherease-assets-dev
S3_PRESIGNED_URL_EXPIRY=3600                 # seconds

# ── SNS ─────────────────────────────────────────────────────────────────────
SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:123456789012:gatherease-notifications-dev

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ── Security ────────────────────────────────────────────────────────────────
# Used for signing guest invite tokens (not Cognito JWTs)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
GUEST_TOKEN_EXPIRE_DAYS=7
